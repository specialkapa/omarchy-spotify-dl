#!/usr/bin/env python3
"""Native messaging host for the Spotify Downloader browser extension.

Accepts Spotify and YouTube links (the same ones bin/spotify-dl accepts).

The browser starts this with the extension's origin as an argument and sends
one length-prefixed JSON message: {"url": "<spotify link>"}. The link is
validated, handed to the running Omarchy shell plugin over IPC, and a reply
{"status": "started|busy|invalid|error", "message": "..."} is sent back.

Nothing from the browser is passed to a shell; the link is a single argv
entry to omarchy-shell, and only links matching the strict Spotify pattern
get that far.
"""

import importlib.machinery
import importlib.util
import json
import os
import shutil
import struct
import subprocess
import sys

MAX_MESSAGE = 64 * 1024
TARGET = "specialkapa.spotify-dl"



def _load_downloader():
    # One source of truth for which links are accepted: bin/spotify-dl's parse_link.
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "spotify-dl")
    loader = importlib.machinery.SourceFileLoader("spotify_dl", path)
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader("spotify_dl", loader))
    loader.exec_module(module)
    return module


def valid_link(url):
    if not isinstance(url, str) or len(url) > 2000 or not url.strip().startswith("https://"):
        return False
    try:
        _load_downloader().parse_link(url.strip())
        return True
    except ValueError:
        return False


def read_message(stream):
    raw = stream.read(4)
    if len(raw) != 4:
        return None
    (length,) = struct.unpack("<I", raw)
    if length > MAX_MESSAGE:
        raise ValueError("message too large")
    body = stream.read(length)
    if len(body) != length:
        return None
    return json.loads(body.decode("utf-8"))


def write_message(stream, obj):
    data = json.dumps(obj).encode("utf-8")
    stream.write(struct.pack("<I", len(data)) + data)
    stream.flush()


def shell_env():
    # The browser starts us without the session environment Omarchy sets up.
    env = dict(os.environ)
    env.setdefault("OMARCHY_PATH", "/usr/share/omarchy")
    env["PATH"] = os.pathsep.join(p for p in [env.get("PATH", ""), os.path.join(env["OMARCHY_PATH"], "bin"),
                                               "/usr/local/bin", "/usr/bin"] if p)
    env.setdefault("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    env.setdefault("LANG", "C.UTF-8")
    return env


def handle(msg):
    url = msg.get("url") if isinstance(msg, dict) else None
    if not valid_link(url):
        return {"status": "invalid", "message": "Not a Spotify or YouTube track, album or playlist link"}
    env = shell_env()
    shell = shutil.which("omarchy-shell", path=env["PATH"])
    if not shell:
        return {"status": "error", "message": "omarchy-shell not found"}
    try:
        out = subprocess.run([shell, TARGET, "download", url.strip()], env=env, stdin=subprocess.DEVNULL,
                             capture_output=True, text=True, timeout=15)
    except subprocess.TimeoutExpired:
        return {"status": "error", "message": "Omarchy shell did not answer"}
    reply = (out.stdout or out.stderr).strip().splitlines()
    reply = reply[-1][:300] if reply else ""
    if out.returncode == 0 and reply == "started":
        return {"status": "started", "message": ""}
    if reply == "busy":
        return {"status": "busy", "message": "A download is already running"}
    if out.returncode != 0 and "not found" in reply.lower():
        return {"status": "error", "message": "Spotify Downloader plugin is not enabled in the Omarchy shell"}
    return {"status": "error", "message": reply or f"omarchy-shell exited {out.returncode}"}


def main():
    try:
        msg = read_message(sys.stdin.buffer)
        if msg is None:
            return 0
        reply = handle(msg)
    except Exception as e:  # noqa: BLE001 - always answer the browser
        reply = {"status": "error", "message": str(e)[:300]}
    write_message(sys.stdout.buffer, reply)
    return 0


if __name__ == "__main__":
    sys.exit(main())
